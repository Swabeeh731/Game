{
  "entities": {
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "A verified parking performance record submitted by a player for a specific level.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the score entry",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Authentication UID of the player",
          "maxLength": 128
        },
        "playerName": {
          "type": "string",
          "description": "Display name of the player",
          "maxLength": 32
        },
        "levelId": {
          "type": "number",
          "description": "Level number (1 through 6)"
        },
        "score": {
          "type": "number",
          "description": "Overall parking score percentage (0-100)"
        },
        "stars": {
          "type": "number",
          "description": "Star rating achieved (1-3)"
        },
        "timeSeconds": {
          "type": "number",
          "description": "Total duration in seconds to complete the park"
        },
        "precisionPct": {
          "type": "number",
          "description": "Position accuracy percentage (0-100)"
        },
        "angleError": {
          "type": "number",
          "description": "Heading deviation in degrees"
        },
        "collisions": {
          "type": "number",
          "description": "Number of obstacle strikes during the run"
        },
        "vehicleId": {
          "type": "string",
          "description": "Identifier of the vehicle used",
          "maxLength": 32
        },
        "vehicleName": {
          "type": "string",
          "description": "Display name of the vehicle",
          "maxLength": 48
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the score was recorded"
        }
      },
      "required": [
        "userId",
        "playerName",
        "levelId",
        "score",
        "stars",
        "timeSeconds",
        "precisionPct",
        "vehicleId",
        "createdAt"
      ]
    },
    "DailyLeaderboardEntry": {
      "title": "DailyLeaderboardEntry",
      "description": "A verified Daily Challenge parking performance record tied to a specific UTC date.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the daily score entry",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Authentication UID of the player",
          "maxLength": 128
        },
        "playerName": {
          "type": "string",
          "description": "Display name of the player",
          "maxLength": 32
        },
        "dateKey": {
          "type": "string",
          "description": "UTC date key in YYYY-MM-DD format",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "challengeTitle": {
          "type": "string",
          "description": "Title of the daily challenge",
          "maxLength": 64
        },
        "levelId": {
          "type": "number",
          "description": "Base level number (1 through 6)"
        },
        "score": {
          "type": "number",
          "description": "Overall parking score percentage (0-100)"
        },
        "stars": {
          "type": "number",
          "description": "Star rating achieved (1-3)"
        },
        "timeSeconds": {
          "type": "number",
          "description": "Total duration in seconds to complete the park"
        },
        "precisionPct": {
          "type": "number",
          "description": "Position accuracy percentage (0-100)"
        },
        "angleError": {
          "type": "number",
          "description": "Heading deviation in degrees"
        },
        "collisions": {
          "type": "number",
          "description": "Number of obstacle strikes during the run"
        },
        "vehicleId": {
          "type": "string",
          "description": "Identifier of the vehicle used",
          "maxLength": 32
        },
        "vehicleName": {
          "type": "string",
          "description": "Display name of the vehicle",
          "maxLength": 48
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the score was recorded"
        }
      },
      "required": [
        "userId",
        "playerName",
        "dateKey",
        "challengeTitle",
        "levelId",
        "score",
        "stars",
        "timeSeconds",
        "precisionPct",
        "vehicleId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/leaderboards/{entryId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Global collection of recorded parking scores and times for all standard levels."
    },
    "/daily_leaderboards/{entryId}": {
      "schema": {
        "$ref": "#/entities/DailyLeaderboardEntry"
      },
      "description": "Separate global collection of recorded Daily Challenge scores keyed by UTC dateKey."
    }
  }
}
